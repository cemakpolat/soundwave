# ==================================
# SOUNDWAVE - Environment Variables
# ==================================
# Copy this file to .env and update values for your environment

# ----------------------------------
# Node Environment
# ----------------------------------
NODE_ENV=development

# ----------------------------------
# Server Configuration
# ----------------------------------
PORT=5001

# ----------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------
# For docker-compose.yml
POSTGRES_USER=soundwave_user
POSTGRES_PASSWORD=soundwave_password
POSTGRES_DB=soundwave_db

# For backend application
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soundwave_db
DB_USER=soundwave_user
DB_PASSWORD=soundwave_password

# ----------------------------------
# JWT Configuration
# ----------------------------------
# IMPORTANT: Use a strong secret (min 32 characters) in production
JWT_SECRET=local-dev-secret-change-in-production-min-32-chars
JWT_EXPIRATION=7d

# ----------------------------------
# File Storage Configuration
# ----------------------------------
# Options: 'local', 'minio', or 's3'
STORAGE_TYPE=local

# For local storage
UPLOAD_DIR=./uploads

# For MinIO storage (if STORAGE_TYPE=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=soundwave
MINIO_ROOT_PASSWORD=soundwave123
MINIO_BUCKET=soundwave-tracks
MINIO_USE_SSL=false

# For S3 storage (if STORAGE_TYPE=s3)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=soundwave-tracks

# ----------------------------------
# CORS Configuration
# ----------------------------------
FRONTEND_URL=http://localhost:3000

# ----------------------------------
# pgAdmin Configuration
# ----------------------------------
PGADMIN_DEFAULT_EMAIL=admin@soundwave.com
PGADMIN_DEFAULT_PASSWORD=admin123

# ----------------------------------
# Redis Configuration (Optional - for caching)
# ----------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ----------------------------------
# Email Configuration (Optional - for notifications)
# ----------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ----------------------------------
# Monitoring & Logging (Optional)
# ----------------------------------
# LOG_LEVEL=info
# SENTRY_DSN=your-sentry-dsn
