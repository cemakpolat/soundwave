{
    "name": "soundwave-backend",
    "version": "1.0.0",
    "description": "Backend for soundwave application",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest --coverage",
        "lint": "eslint .",
        "migrate": "sequelize-cli db:migrate",
        "seed": "sequelize-cli db:seed:all",
        "docker:build": "docker build -t soundwave-backend .",
        "docker:run": "docker run -p 5000:5000 soundwave-backend",
        "seed_test_data": "node seed.js"
    },
    "dependencies": {
        "aws-sdk": "^2.1692.0",
        "bcrypt": "^5.1.1",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "express-validator": "^6.15.0",
        "helmet": "^6.1.5",
        "ioredis": "^5.3.1",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "pg": "^8.13.3",
        "sequelize": "^6.37.6",
        "sequelize-cli": "^6.6.0",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "eslint": "^8.36.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-plugin-import": "^2.27.5",
        "jest": "^29.5.0",
        "nodemon": "^2.0.22",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "coveragePathIgnorePatterns": [
            "/node_modules/",
            "/tests/"
        ]
    },
    "eslintConfig": {
        "extends": "airbnb-base",
        "rules": {
            "no-console": "off",
            "import/no-extraneous-dependencies": [
                "error",
                {
                    "devDependencies": true
                }
            ]
        }
    }
}
